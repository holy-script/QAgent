# --- Neon Postgres ---
# Pooled URL (host contains "-pooler"): used by the app.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL (same host without "-pooler"): used by Alembic migrations and the LangGraph checkpointer.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-sample.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Neon Object Storage (S3-compatible) ---
NEON_S3_ENDPOINT=https://br-sample.storage.c-4.ap-southeast-1.aws.neon.tech
NEON_S3_ACCESS_KEY_ID=nak_sample
NEON_S3_SECRET_ACCESS_KEY=nsk_sample
NEON_S3_REGION=ap-southeast-1
NEON_S3_BUCKET=qagent-artifacts

# --- Jev (TypeSafe AI) ---
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_API_TOKEN=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_MAX_CONCURRENCY=4

# --- Claude on Bedrock ---
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Gating ---
GATE_AUTO_MIN=0.75
GATE_ESCALATE_MIN=0.45

# --- Runtime ---
QAGENT_ALLOWED_HOSTS=localhost,127.0.0.1
FLOW_STEP_BUDGET=25
FLOW_TIME_BUDGET_S=90
FLOW_MAX_PARALLEL=3
NETWORK_BODY_CAP_KB=256

# --- Demo & Local Dev ---
DEMO_SHOP_URL=http://localhost:8001
API_URL=http://localhost:8000

# --- Frontend (frontend/.env.local) ---
# Leave unset to run on in-browser fixtures (no backend). Set to switch to the real API (F6).
# NEXT_PUBLIC_API_URL=http://localhost:8000
