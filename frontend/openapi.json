      "get": {
        "tags": [
          "Dev & Fixtures"
        ],
        "summary": "Sse Replay",
        "description": "Streams recorded QA run events over SSE.\nFrontend Coder 2 connects to this to design real-time charts, telemetry, and step cards.",
